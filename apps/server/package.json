{
  "name": "@kago/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql && node --test test/smoke.mjs",
    "test:remote": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql && node --test test/remote.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.0.2",
    "adm-zip": "^0.5.16",
    "exiftool-vendored": "^39.0.0",
    "fastify": "^5.3.3",
    "mime-types": "^2.1.35",
    "mupdf": "^1.28.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/mime-types": "^2.1.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
