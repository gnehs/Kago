{
  "name": "kago",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @kago/server --filter @kago/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:smoke": "pnpm --filter @kago/server test:smoke",
    "notices": "node scripts/third-party-notices.mjs",
    "i18n": "node scripts/i18n.mjs",
    "start": "pnpm --filter @kago/server start"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
