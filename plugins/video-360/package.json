{
  "name": "@kago/plugin-video-360",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "kago": {
    "api": 1,
    "title": "360° video viewer",
    "previewers": [
      {
        "id": "video-360",
        "extensions": ["osv", "insv"],
        "entry": "index.html",
        "companions": [
          { "replace": "_00_", "with": "_10_" },
          { "replace": "_10_", "with": "_00_" }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test:plugins": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@kago/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.4.4"
  }
}
